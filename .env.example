# LOCOXATL order persistence (MySQL)
# Copy this file to .env in the project root and fill in your local credentials.
# Never commit the real .env file, and never expose these values to the browser.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=locoxatl
DB_PASSWORD=change-me
DB_NAME=locoxatl
DB_CONNECTION_LIMIT=5

# Admin dashboard authentication credentials (scrypt hashed in DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-admin-password

# Public customer contact links (not API credentials)
# Leave a placeholder to use the built-in default from src/server/public-config.js:
#   WHATSAPP_BUSINESS_NUMBER = +62 812-8211-6351
#   INSTAGRAM_URL            = https://www.instagram.com/locoxatl?rpxt=bGlxY2ExOGY4OWRz
# Set a real value here to override the default.
WHATSAPP_BUSINESS_NUMBER=[ISI_NOMOR_WA_628XXX]
INSTAGRAM_URL=[ISI_LINK_INSTAGRAM]

# Optional: preview server port (defaults to 4173)
# PORT=4173

# Optional: open the browser automatically when running npm start
# OPEN_BROWSER=1

# ---------------------------------------------------------------------------
# Image storage for artist, member and product images
# ---------------------------------------------------------------------------
# Set all three Cloudinary values to store uploads in persistent external object storage.
# This is required on Railway: the container filesystem is ephemeral, so an uploaded image
# would disappear on the next deploy. Only the resulting URL is written to MySQL; these
# credentials are server-side only and are never exposed to the browser.
# Leave all three empty for local development to use assets/uploads/catalog instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Cloudinary folder for the uploads (defaults to locoxatl/catalog)
# CLOUDINARY_FOLDER=locoxatl/catalog
